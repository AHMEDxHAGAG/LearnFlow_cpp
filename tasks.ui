  <property name="styleSheet">
   <string notr="true">
    QWidget#LearnFlowDesktop {
      background-color: #EAF7F6;
    }

    /* Sidebar */
    QFrame#sidebar {
      background-color: #EAF7F6;
      border-right: 1px solid rgba(0, 0, 0, 0.08);
      min-width: 72px;
      max-width: 72px;
    }

    /* Logo button */
    QPushButton#logoBtn {
      background: transparent;
      border: none;
      padding: 8px;
      qproperty-icon: none;
      color: #06B6A4;
      font-size: 18px;
      font-family: &quot;Segoe UI&quot;, sans-serif;
    }

    /* Nav buttons base */
    QPushButton#navHome, QPushButton#navCalendar {
      background: transparent;
      border: 1px solid #06B6A4;
      border-radius: 25px;
      color: #065F56;
      font-family: &quot;Inter&quot;, &quot;Segoe UI&quot;, sans-serif;
      font-size: 13px;
      font-weight: 500;
      padding: 12px 8px;
      min-height: 120px;
      max-width: 53px;
    }
    QPushButton#navHome:hover, QPushButton#navCalendar:hover {
      background-color: rgba(6, 182, 164, 0.1);
    }

    /* Active nav button */
    QPushButton#navTasks {
      background-color: #06B6A4;
      border: none;
      border-radius: 25px;
      color: #EAF7F6;
      font-family: &quot;Inter&quot;, &quot;Segoe UI&quot;, sans-serif;
      font-size: 14px;
      font-weight: 500;
      padding: 12px 8px;
      min-height: 120px;
      max-width: 53px;
    }
    QPushButton#navTasks:hover {
      background-color: #059E8E;
    }

    /* Settings button */
    QPushButton#settingsBtn {
      background: transparent;
      border: none;
      padding: 8px;
      color: #065F56;
      font-size: 20px;
    }
    QPushButton#settingsBtn:hover {
      color: #06B6A4;
    }

    /* Search bar */
    QLineEdit#searchBar {
      background-color: rgba(255, 255, 255, 0.25);
      border: 1px solid rgba(0, 0, 0, 0.06);
      border-radius: 25px;
      padding: 14px 20px 14px 44px;
      font-family: &quot;Roboto&quot;, &quot;Segoe UI&quot;, sans-serif;
      font-size: 18px;
      color: #065D54;
    }
    QLineEdit#searchBar:focus {
      border: 1px solid #06B6A4;
    }

    /* Filter buttons */
    QPushButton#filterAll {
      background-color: #06B6A4;
      border: none;
      border-radius: 20px;
      color: white;
      font-family: &quot;Roboto&quot;, &quot;Segoe UI&quot;, sans-serif;
      font-size: 18px;
      font-weight: 600;
      padding: 10px 22px;
      min-height: 40px;
    }
    QPushButton#filterAll:hover {
      background-color: #059E8E;
    }
    QPushButton#filterAll:checked {
      background-color: #06B6A4;
    }

    QPushButton#filterOverdue, QPushButton#filterHighPriority {
      background: transparent;
      border: 1px solid #065F56;
      border-radius: 20px;
      color: #065F56;
      font-family: &quot;Roboto&quot;, &quot;Segoe UI&quot;, sans-serif;
      font-size: 18px;
      font-weight: 600;
      padding: 10px 22px;
      min-height: 40px;
    }
    QPushButton#filterOverdue:hover, QPushButton#filterHighPriority:hover {
      background-color: rgba(6, 95, 86, 0.08);
    }
    QPushButton#filterOverdue:checked, QPushButton#filterHighPriority:checked {
      background-color: #06B6A4;
      border: none;
      color: white;
    }

    /* Content area */
    QFrame#contentArea {
      background: transparent;
      border: none;
    }
   </string>
