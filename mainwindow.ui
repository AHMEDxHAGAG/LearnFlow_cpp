  <property name="styleSheet">
   <string notr="true">
QWidget#MainWindow {
  background-color: #EAF7F6;
}

QFrame#sidebar {
  background-color: #EAF7F6;
  border-right: 1px solid rgba(0, 0, 0, 0.08);
}

QLabel#sidebarCheckIcon {
  color: #06B6A4;
  font-size: 20px;
}

QPushButton#navHome {
  border: none;
  background: transparent;
  border-image: url(:/home.png) 0 0 0 0 stretch stretch;
  min-height: 142px;
  max-width: 53px;
}

QPushButton#navHome:hover {
  opacity: 0.9;
}

QPushButton#navTasks {
  border: none;
  background: transparent;
  border-image: url(:/nottasks.png) 0 0 0 0 stretch stretch;
  min-height: 144px;
  max-width: 53px;
}

QPushButton#navCalendar {
  border: none;
  background: transparent;
  border-image: url(:/notcalendar.png) 0 0 0 0 stretch stretch;
  min-height: 170px;
  max-width: 53px;
}

QPushButton#navTasks:hover,
QPushButton#navCalendar:hover {
  opacity: 0.9;
}

QPushButton#settingsButton {
  background-color: transparent;
  border: none;
  padding: 4px;
}

QPushButton#settingsButton:hover {
  background-color: rgba(6, 95, 86, 0.1);
  border-radius: 8px;
}

QLabel#profileImage {
  border-radius: 38px;
  background-color: #cccccc;
}

QLabel#greetingHello {
  font-family: 'Roboto Flex';
  font-weight: 900;
  font-size: 80px;
  color: #111111;
}

QLabel#greetingName {
  font-family: 'Patrick Hand';
  font-weight: 400;
  font-size: 55px;
  color: #111111;
}

QPushButton#fabButton {
  background-color: #06B6A4;
  color: white;
  border: none;
  border-radius: 32px;
  font-family: 'Inter';
  font-weight: 300;
  font-size: 36px;
}

QPushButton#fabButton:hover {
  background-color: #059E8E;
}

QPushButton#fabButton:pressed {
  background-color: #048A7C;
}

QLabel#questionMark {
  font-family: 'Pecita';
  font-size: 64px;
  color: #06B6A4;
}

QLabel#tasksHeading {
  font-family: 'Roboto Flex';
  font-weight: 900;
  font-size: 70px;
  color: #065F56;
}

QFrame#cardTotalTasks,
QFrame#cardInProgress,
QFrame#cardProductivity,
QFrame#cardCompleted {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 rgba(255,255,255,0.92),
    stop:0.5 rgba(255,255,255,0.78),
    stop:1 rgba(245,248,247,0.60));
  border: 2px solid rgba(255,255,255,0.96);
  border-top-color: rgba(255,255,255,1.0);
  border-left-color: rgba(255,255,255,0.98);
  border-bottom-color: rgba(200,210,208,0.40);
  border-right-color: rgba(200,210,208,0.30);
  border-radius: 22px;
}

QFrame#cardTotalTasks:hover,
QFrame#cardInProgress:hover,
QFrame#cardProductivity:hover,
QFrame#cardCompleted:hover {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 rgba(255,255,255,0.98),
    stop:0.5 rgba(255,255,255,0.88),
    stop:1 rgba(250,252,251,0.72));
  border: 2px solid rgba(255,255,255,1.0);
  border-bottom-color: rgba(200,210,208,0.45);
}

QLabel#labelTotalTasks,
QLabel#labelInProgress,
QLabel#labelProductivity,
QLabel#labelCompleted {
  font-family: 'Inter';
  font-weight: 400;
  font-size: 14px;
  color: #6A7282;
  background: transparent;
}

QLabel#valueTotalTasks,
QLabel#valueInProgress,
QLabel#valueProductivity,
QLabel#valueCompleted {
  font-family: 'Inter';
  font-weight: 900;
  font-size: 36px;
  color: #111111;
  background: transparent;
}

QFrame#iconContainerBlue {
  background-color: #DBEAFE;
  border-radius: 14px;
  min-width: 48px;
  min-height: 48px;
  max-width: 48px;
  max-height: 48px;
}

QFrame#iconContainerOrange {
  background-color: #FFEDD4;
  border-radius: 14px;
  min-width: 48px;
  min-height: 48px;
  max-width: 48px;
  max-height: 48px;
}

QFrame#iconContainerPurple {
  background-color: #F3E8FF;
  border-radius: 14px;
  min-width: 48px;
  min-height: 48px;
  max-width: 48px;
  max-height: 48px;
}

QFrame#iconContainerGreen {
  background-color: #DCFCE7;
  border-radius: 14px;
  min-width: 48px;
  min-height: 48px;
  max-width: 48px;
  max-height: 48px;
}

QLabel#iconTotalTasks {
  color: #155DFC;
  font-weight: 900;
  font-size: 24px;
  background: transparent;
}

QLabel#iconInProgress {
  color: #F54900;
  font-weight: 900;
  font-size: 24px;
  background: transparent;
}

QLabel#iconProductivity {
  color: #9810FA;
  font-weight: 900;
  font-size: 24px;
  background: transparent;
}

QLabel#iconCompleted {
  color: #00A63E;
  font-weight: 900;
  font-size: 24px;
  background: transparent;
}

QStackedWidget#contentStack {
  background: transparent;
}

QWidget#homePage,
QWidget#tasksPage,
QWidget#calendarPage {
  background: transparent;
}

QLabel#tasksPageTitle,
QLabel#calendarPageTitle {
  font-family: 'Roboto Flex';
  font-weight: 900;
  font-size: 70px;
  color: #065F56;
}

QLabel#calendarDate {
  font-family: 'Inter';
  font-weight: 500;
  font-size: 60px;
  color: #7b8185;
}

QLabel#homeBackground,
QLabel#tasksBackground,
QLabel#calendarBackground {
  background-image: url(:/BackgroundPattern.png);
  background-repeat: repeat;
}

QLabel#homeFadeOverlay,
QLabel#tasksFadeOverlay,
QLabel#calendarFadeOverlay {
  background-color: rgba(234, 247, 246, 230);
}

QScrollBar:vertical {
  background: transparent;
  width: 8px;
  margin: 0;
}

QScrollBar::handle:vertical {
  background: rgba(6, 95, 86, 0.3);
  border-radius: 4px;
  min-height: 30px;
}

QScrollBar::handle:vertical:hover {
  background: rgba(6, 95, 86, 0.5);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
}
   
/* Tasks Page */
QLineEdit#tasksSearchBar {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 rgba(255,255,255,0.88),
    stop:1 rgba(255,255,255,0.58));
  border: 2px solid rgba(255,255,255,0.95);
  border-top-color: rgba(255,255,255,1.0);
  border-left-color: rgba(255,255,255,0.98);
  border-bottom-color: rgba(200,210,208,0.45);
  border-right-color: rgba(200,210,208,0.35);
  border-radius: 30px;
  padding: 0px 24px 0px 56px;
  font-family: 'Inter';
  font-size: 18px;
  color: #374151;
  min-height: 60px;
  selection-background-color: #06B6A4;
  selection-color: white;
}
QLineEdit#tasksSearchBar:hover {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 rgba(255,255,255,0.94),
    stop:1 rgba(255,255,255,0.68));
  border: 2px solid rgba(255,255,255,1.0);
  border-bottom-color: rgba(200,210,208,0.50);
}
QLineEdit#tasksSearchBar:focus {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 rgba(255,255,255,0.96),
    stop:1 rgba(255,255,255,0.72));
  border: 2px solid rgba(6, 182, 164, 0.45);
  border-top-color: rgba(6, 182, 164, 0.55);
}
QLabel#tasksSearchIcon {
  background: transparent;
}
QPushButton#filterAll {
  background-color: #06B6A4;
  border: none;
  border-radius: 28px;
  color: white;
  font-family: 'Inter';
  font-size: 18px;
  font-weight: 700;
  padding: 6px 20px;
  min-height: 20px;
}
QPushButton#filterAll:hover {
  background-color: #059E8E;
}
QPushButton#filterOverdue, QPushButton#filterHighPriority {
  background-color: transparent;
  border: 1px solid #065F56;
  border-radius: 28px;
  color: #065F56;
  font-family: 'Inter';
  font-size: 18px;
  font-weight: 600;
  padding: 6px 20px;
  min-height: 20px;
}
QPushButton#filterOverdue:hover, QPushButton#filterHighPriority:hover {
  background-color: rgba(6, 182, 164, 0.1);
}
/* Calendar Arrows */
QPushButton#calBtnPrev, QPushButton#calBtnNext {
  border: none;
  background-color: transparent;
  border-radius: 28px;
}
QPushButton#calBtnPrev:hover, QPushButton#calBtnNext:hover {
  background-color: rgba(6, 182, 164, 0.12);
}
</string>
